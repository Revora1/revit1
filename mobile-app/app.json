{
  "expo": {
    "name": "RevitUp",
    "slug": "revitup",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "extra": {
      "eas": {
        "projectId": "1e9392c2-6443-4c87-8ff2-cd2c76425689"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "today.revitup.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "RevitUp needs access to your camera.",
        "NSPhotoLibraryUsageDescription": "RevitUp needs access to your photo library.",
        "NSMicrophoneUsageDescription": "RevitUp needs access to your microphone to record audio."
      }
    },
    "android": {
      "package": "today.revitup.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "RevitUp needs access to your photo library.",
          "cameraPermission": "RevitUp needs access to your camera."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2103649447635694~2975257474",
          "iosAppId": "ca-app-pub-2103649447635694~2975257474"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "scheme": "revitup"
  }
}