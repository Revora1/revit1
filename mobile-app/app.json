{
  "expo": {
    "name": "RevitUp",
    "slug": "revitup",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "extra": {
      "eas": {
        "projectId": "1e9392c2-6443-4c87-8ff2-cd2c76425689"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "today.revitup.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "RevitUp requires access to your photo library so you can select and upload photos of your car builds, garage vehicles, marketplace listings, group posts, stories, and mechanic business banners.",
        "NSPhotoLibraryAddUsageDescription": "RevitUp requires access to save photos of your vehicle builds and marketplace listings to your photo library."
      }
    },
    "android": {
      "package": "com.revitup.network",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "RevitUp requires access to your photo library so you can select and upload photos of your car builds, garage vehicles, marketplace listings, group posts, stories, and mechanic business banners.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2103649447635694~2975257474",
          "iosAppId": "ca-app-pub-2103649447635694~2975257474"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m -Dfile.encoding=UTF-8"
            },
            "kotlinCompilerArgs": [
              "-Xskip-metadata-version-check"
            ]
          }
        }
      ]
    ],
    "scheme": "revitup"
  }
}